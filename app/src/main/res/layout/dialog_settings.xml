<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollSettings"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_pill_sort"
        android:backgroundTint="@color/stroke_border" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-bold"
        android:text="@string/settings_title"
        android:textColor="@color/text_primary"
        android:textSize="20sp" />

    <!-- 1. Theme Mode Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="THEME &amp; APPEARANCE"
        android:textColor="@color/neon_cyan"
        android:textSize="12sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgThemeMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card_rounded"
        android:orientation="vertical"
        android:padding="12dp">

        <RadioButton
            android:id="@+id/rbThemeDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="AMOLED Dark Mode (Recommended)"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbThemeLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Modern Light Mode"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rbThemeSystem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Follow System Default"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </RadioGroup>

    <!-- 2. Default Track Artwork Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="DEFAULT TRACK ARTWORK &amp; THUMBNAIL"
        android:textColor="@color/neon_cyan"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card_rounded"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivDefaultArtPreview"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:scaleType="centerCrop"
                android:src="@drawable/car_default_photo"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDefaultArtTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Global Default Artwork"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvDefaultArtStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Active: Car Default Photo"
                    android:textColor="@color/neon_cyan"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Shown on track list and Now Playing unless custom artwork is set for that specific song."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickDefaultArt"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Choose Custom Default Photo"
            android:textColor="@color/neon_cyan"
            app:backgroundTint="@color/surface_dark"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_album"
            app:iconTint="@color/neon_cyan" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetDefaultArt"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reset to Car Default Photo"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <!-- 3. Backup & Restore Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="BACKUP &amp; RESTORE (KEEP YOUR DATA)"
        android:textColor="@color/neon_cyan"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card_rounded"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keep an automatic copy of your lyrics, sync timers, favorites, playlists and artwork in a folder that stays after uninstall."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvAutoBackupStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Choose a folder. UltraDeep will refresh its backup when opened and when it goes to the background."
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChooseAutoBackupFolder"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Choose automatic backup folder"
            android:textColor="@color/neon_cyan"
            app:backgroundTint="@color/surface_dark"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_album"
            app:iconTint="@color/neon_cyan" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackupNow"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Back up now"
                android:textColor="@color/neon_cyan" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestoreAutoBackup"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Restore backup"
                android:textColor="@color/neon_cyan" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportBackup"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Export Backup (Save File)"
            android:textColor="@color/neon_cyan"
            app:backgroundTint="@color/surface_dark"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_queue"
            app:iconTint="@color/neon_cyan" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImportBackup"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Import &amp; Restore Backup File"
            android:textColor="@color/neon_cyan" />
    </LinearLayout>

    <!-- 4. Lyrics download controls. Downloads are always opt-in and never replace saved lyrics. -->
    <TextView
        android:id="@+id/lyricsSyncSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="LYRICS DOWNLOAD &amp; SAVE"
        android:textColor="@color/neon_cyan"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card_rounded"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvLyricsSyncStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Downloads only tracks without saved lyrics. Existing fetched and custom lyrics are kept."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSyncMissingLyrics"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Sync lyrics for unsaved tracks"
            android:textColor="@color/neon_cyan"
            app:backgroundTint="@color/surface_dark"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_lyrics"
            app:iconTint="@color/neon_cyan" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSyncLyricsAfterDate"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sync only tracks added after a date"
            android:textColor="@color/neon_cyan" />
    </LinearLayout>

    <!-- 5. Storage Scanning Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="FILE SYSTEM &amp; SYNC"
        android:textColor="@color/neon_cyan"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/btnRescanStorage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card_rounded"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivRescanIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_refresh"
            app:tint="@color/neon_cyan" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/rescan_storage"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvRescanStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/rescan_desc"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
</ScrollView>
