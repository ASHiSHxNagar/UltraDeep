<?xml version="1.0" encoding="utf-8"?>
<!-- Spotify-style glassmorphism background for the lyrics container.
     A very subtle semi-transparent dark rounded rectangle that lets the
     fluid ambient orbs bleed through while keeping lyrics legible. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#24080D1E" />
    <stroke
        android:width="1.2dp"
        android:color="#35FFFFFF" />
    <corners android:radius="26dp" />
</shape>
